<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    
    <!-- Объявление макросов -->
    <xacro:macro name="wheel_link" params="prefix">
        <link name="${prefix}_wheel_link">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_height}"/>
                </geometry>
                <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_height}"/>
                </geometry>
                <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
            </collision>
            <xacro:inertia_of_cylinder mass="${wheel_mass}" height="${wheel_height}" radius="${wheel_radius}"/>
        </link>
    </xacro:macro>

    <xacro:macro name="caster_link" params="prefix">
        <link name="${prefix}_caster_link">
            <visual>
                <geometry>
                    <sphere radius="${caster_radius}"/>
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </visual>
            <collision>
                <geometry>
                    <sphere radius="${caster_radius}"/>
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </collision>
            <xacro:inertia_of_sphere mass="${caster_mass}" radius="${caster_radius}"/>
        </link>
    </xacro:macro>
   
    <xacro:macro name="base_wheel_joint" params="position child_name offset" >
        <joint name="base_${position}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${child_name}"/>
            <origin xyz="0 ${offset} 0"/>
            <axis xyz="0 1 0"/>
        </joint>
    </xacro:macro>
 
    <xacro:macro name="base_caster_joint" params="position child_name offset" >
        <joint name="$base_${position}_caster_joint" type="fixed">
            <parent link="base_link"/>
            <child link="${child_name}"/>
            <origin xyz="${offset} 0 0"/>
        </joint>
    </xacro:macro>

    
    <!-- Вызов макросов -->
    <xacro:wheel_link prefix="left"/>
    <xacro:wheel_link prefix="right"/>

    <xacro:caster_link prefix="front"/>
    <xacro:caster_link prefix="rear"/>

    <xacro:base_wheel_joint position="left" child_name="left_wheel_link" offset="${wheel_separation / 2}"/>
    <xacro:base_wheel_joint position="right" child_name="right_wheel_link" offset="${-wheel_separation / 2}"/>

    <xacro:base_caster_joint position="front" child_name="front_caster_link" offset="${base_length / 2}"/>
    <xacro:base_caster_joint position="rear" child_name="rear_caster_link" offset="${-base_length / 2}"/>

</robot>