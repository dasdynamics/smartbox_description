<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Параметры -->
    <xacro:property name="base_mass" value="1"/>
    <xacro:property name="base_length" value="0.1"/>
    <xacro:property name="base_width" value="0.1"/>
    <xacro:property name="base_height" value="0.1"/>

    <xacro:property name="wheel_mass" value="0.1"/>
    <xacro:property name="wheel_height" value="0.1"/>
    <xacro:property name="wheel_radius" value="0.1"/>
    <xacro:property name="wheel_separation" value="0.1"/>

    <xacro:property name="caster_mass" value="0.1"/>
    <xacro:property name="caster_radius" value="0.01"/>

</robot>