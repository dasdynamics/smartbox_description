<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Box propreties -->
    <!-- Chassis_box -->
    <xacro:property name="chassis_box_mass" value="1.0"/>
    <xacro:property name="chassis_box_length" value="0.25"/>
    <xacro:property name="chassis_box_width" value="0.25"/>
    <xacro:property name="chassis_box_height" value="0.1"/>

    <xacro:property name="drive_wheel_mass" value="0.1"/>
    <xacro:property name="drive_wheel_height" value="0.05"/>
    <xacro:property name="drive_wheel_radius" value="0.07"/>
    <xacro:property name="drive_wheel_separation" value="0.4"/>

    <xacro:property name="support_wheel_mass" value="0.1"/>
    <xacro:property name="support_wheel_radius" value="0.069"/>
    <xacro:property name="support_wheel_separation" value="0.2"/>

    <!-- Lidar box -->
    <xacro:property name="lidar_box_mass" value="1.0"/>
    <xacro:property name="lidar_box_length" value="0.25"/>
    <xacro:property name="lidar_box_width" value="0.25"/>
    <xacro:property name="lidar_box_height" value="0.1"/>

    <xacro:property name="lidar_mass" value="1.0"/>
    <xacro:property name="lidar_height" value="0.01"/>
    <xacro:property name="lidar_radius" value="0.07"/>


</robot>